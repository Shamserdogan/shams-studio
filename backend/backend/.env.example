# SHAMS STUDIO Backend Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shams_studio?retryWrites=true&w=majority
JWT_SECRET=shams_studio_jwt_secret_key_2026_change_this_in_production
CLIENT_URL=http://localhost:3000

# Cloudinary Free Tier Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin User Credentials (for auto-seeding)
ADMIN_NAME="Shams Admin"
ADMIN_EMAIL=admin@shamsstudio.com
ADMIN_PASSWORD=admin123456
